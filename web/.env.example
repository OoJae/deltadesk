# web/.env.example: copy to .env.local and fill in. Never commit real values.

# Site (Study, Live desk, Tearsheet, League): server-side only.
# Base URL of the DeltaDesk engine API (default http://127.0.0.1:8787).
DELTADESK_API=
# Premium key the engine expects for the tearsheet and other paid reads.
DELTADESK_API_KEY=

# Desk (/desk): NEXT_PUBLIC_ values are inlined into the browser bundle at build time, so rebuild after changing them.
# Dynamic environment id (the sandbox for M2); unset shows "Dynamic not configured" and /desk/<lane> stays read-only.
NEXT_PUBLIC_DYNAMIC_ENV_ID=
# DeskLaneFactory address on Robinhood Chain (4663); unset shows "not deployed yet" and lane creation stays locked.
NEXT_PUBLIC_DESK_FACTORY=
# Optional watchdog (guardian) address written into new lanes; unset means no guardian.
NEXT_PUBLIC_DESK_GUARDIAN=

# Desk proxy to desk-agent (/api/desk/*): server-side only, never sent to the browser.
# Base URL of desk-agent, e.g. its Railway URL.
AGENT_API_URL=
# Shared key sent as x-desk-agent-key; must equal desk-agent's DESK_AGENT_API_KEY.
AGENT_API_KEY=
