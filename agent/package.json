{
  "name": "deltadesk-agent",
  "version": "0.2.0",
  "private": true,
  "description": "DeltaDesk desk agent: operates DeskLane clones on Robinhood Chain (4663) through a delegated operator wallet",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "tsx src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fork": "vitest run -c vitest.fork.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "abi:sync": "tsx scripts/abi-sync.ts",
    "status": "tsx scripts/status.ts",
    "signer-check": "tsx scripts/signer-check.ts",
    "desk-exit": "tsx scripts/desk-exit.ts",
    "gen-rsa": "tsx scripts/gen-rsa.ts",
    "create-server-wallet": "tsx scripts/create-server-wallet.ts",
    "watchdog": "tsx src/watchdog/main.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@dynamic-labs-wallet/node",
      "better-sqlite3",
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@dynamic-labs-wallet/node": "1.1.14",
    "@dynamic-labs-wallet/node-evm": "1.1.14",
    "@hono/node-server": "^2.1.1",
    "@nktkas/hyperliquid": "0.33.3",
    "better-sqlite3": "^13.0.2",
    "dotenv": "^17.4.2",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "ulid": "^3.0.2",
    "viem": "^2.55.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "fast-check": "^4.9.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
