# DeltaDesk desk agent. Empty values are treated as unset. Defaults are safe: DRY_RUN=true,
# DESK_ARM=0, advisory mode, paper HL, identity overlay. src/config.ts refuses unsafe combinations.

# ---- Chain (Robinhood Chain 4663)
CHAIN_ID=4663
RH_RPC_URL=                      # Alchemy https://robinhood-mainnet.g.alchemy.com/v2/<key> (default: public RPC)
RH_RPC_FALLBACK_URL=
EXPLORER_URL=https://explorer.mainnet.chain.robinhood.com

# ---- Desk contracts (from contracts/deployments/4663.json after deploy)
DESK_FACTORY_ADDRESS=
DESK_LANE_A=                     # lane A clone (NVDA/USDG); lanes are also registered via POST /desks
DESK_LANE_B=

# ---- Signer: the OPERATOR wallet, never the owner
SIGNER_KIND=dynamic-delegated    # dynamic-delegated | dynamic-server | local (local: loopback RPC only)
LOCAL_SIGNER_PRIVATE_KEY=        # anvil / fork only

# ---- Dynamic (sandbox)
DYNAMIC_ENVIRONMENT_ID=
DYNAMIC_API_KEY=                 # dyn_... server API token
DYNAMIC_WEBHOOK_SECRET=          # HMAC secret for x-dynamic-signature-256
DYNAMIC_RSA_PRIVATE_KEY_PATH=    # from `pnpm gen-rsa`, or inline:
DYNAMIC_RSA_PRIVATE_KEY_PEM=
DYNAMIC_JWKS_URL=                # default: https://app.dynamic.xyz/api/v0/sdk/<env>/.well-known/jwks
DYNAMIC_BASE_API_URL=
DYNAMIC_SERVER_WALLET_ADDRESS=   # Plan B operator (dynamic-server)

# ---- Vault (AES-256-GCM envelope encryption of delegated credentials)
DESK_VAULT_KEK_B64=              # 32 random bytes, base64 (a sealed Railway variable)
DESK_VAULT_KEK_ID=k1

# ---- LLM overlay (Bankr gateway, Anthropic protocol; OFF in M2)
BANKR_LLM_API_KEY=               # bk_...
BANKR_LLM_BASE_URL=https://llm.bankr.bot
DESK_LLM_MODEL=
DESK_OVERLAY=0

# ---- Telegram (alerts + approve/deny buttons). The agent long-polls this bot; never reuse it as
# the watchdog's WATCHDOG_TELEGRAM_BOT_TOKEN (two pollers on one bot swallow each other's updates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- DeltaDesk engine API (basis k, hour-of-week record)
DELTADESK_API_URL=https://core-production-512e.up.railway.app
DELTADESK_API_KEY=               # premium header x-deltadesk-key
DESK_BASIS_TTL_SEC=600

# ---- Robinhood / Hyperliquid
RH_API_URL=https://api.robinhood.com/rhj
HL_MODE=paper                    # paper | live (live also needs HL_ARM=1 and the keys; unused in M2)
HL_ARM=0
HL_WS_URL=wss://api.hyperliquid.xyz/ws
HL_INFO_URL=https://api.hyperliquid.xyz/info
HL_ACCOUNT_ADDRESS=
HL_AGENT_PRIVATE_KEY=

# ---- Safety (strict enums: anything else refuses to start)
DRY_RUN=true
DESK_ARM=0                       # must be 1 for any write on 4663
DESK_MODE=advisory               # default mode for new desks: advisory | copilot | autopilot
DESK_SENSE_MOCK=0

# ---- Limits (must sit inside the lane's on-chain caps: checked at startup)
DESK_MAX_ACTION_USD=60
DESK_DAILY_TURNOVER_USD=150
DESK_GAS_RESERVE_ETH=0.001
DESK_MAX_FEE_GWEI=2
DESK_FEE_FLOOR_GWEI=0.02
DESK_MAX_GAS_USD=2
DESK_RERANGES_PER_HOUR=4
DESK_RERANGES_PER_DAY=24
DESK_MIN_RERANGE_INTERVAL_SEC=300
DESK_DEADLINE_SEC=45

# ---- Timing
DESK_TICK_SEC=5
DESK_RECONCILE_SEC=30
DESK_APPROVAL_WINDOW_SEC=120
DESK_CANCEL_WINDOW_SEC=0

# ---- Runtime
DESK_DB_PATH=data/desk.sqlite
DESK_APPROVAL_DIR=data/approvals
PORT=8080
DESK_HTTP_HOST=0.0.0.0
DESK_AGENT_API_KEY=              # shared with the web's server-side route handlers (>= 24 chars)
LOG_LEVEL=info

# ---- Watchdog (separate service: GUARDIAN key only, never the operator's secrets)
WATCHDOG_GUARDIAN_PRIVATE_KEY=
WATCHDOG_AGENT_URL=
WATCHDOG_ARM=0
WATCHDOG_DRY_RUN=true
WATCHDOG_INTERVAL_SEC=30
WATCHDOG_NAV_DROP_PCT=3
WATCHDOG_REVERT_STREAK=3
WATCHDOG_RERANGE_HEADROOM=1
WATCHDOG_DEADMAN_MIN=15
WATCHDOG_OPERATOR_RESERVE_ETH=0.001
WATCHDOG_TELEGRAM_BOT_TOKEN=     # the watchdog's OWN bot (its /pause listener); refused if equal to TELEGRAM_BOT_TOKEN
WATCHDOG_TELEGRAM_CHAT_ID=       # default: TELEGRAM_CHAT_ID. Without its own bot the watchdog only sends alerts

# ---- Fork tests (`pnpm test:fork`; skipped when unset)
FORK_RPC_URL=
FORK_BLOCK_NUMBER=
FORK_ANVIL_PORT=8546
