    "safe-to-lp": {
      "description": "Should you provide liquidity to this tokenized-stock pool right now? ALLOW / CAUTION / BLOCK with reasons: gap between the pool price and Hyperliquid-derived fair value, market regime (open, overnight, weekend dark window, reopen), and the pool's historical LP edge for this hour of the week. Robinhood Chain Uniswap pools: NVDA, SPY, TSLA, QQQ-SPY.",
      "price": "0.005",
      "paymentScheme": "exact",
      "methods": [
        "GET"
      ],
      "category": "data",
      "tags": [
        "tokenized-stocks",
        "liquidity",
        "uniswap",
        "risk",
        "robinhood-chain",
        "lp"
      ],
      "schema": {
        "input": {
          "type": "object",
          "properties": {
            "pool": {
              "type": "string",
              "description": "Pool: NVDA, SPY, TSLA or QQQ-SPY",
              "enum": [
                "NVDA",
                "SPY",
                "TSLA",
                "QQQ-SPY"
              ]
            }
          },
          "required": [
            "pool"
          ]
        },
        "output": {
          "type": "object",
          "properties": {
            "verdict": {
              "type": "string",
              "enum": [
                "ALLOW",
                "CAUTION",
                "BLOCK"
              ],
              "description": "Recommendation for adding liquidity now"
            },
            "reasons": {
              "type": "array",
              "description": "Why, each with a level and a human-readable reason"
            },
            "gap_bps": {
